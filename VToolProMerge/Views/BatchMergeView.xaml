<UserControl x:Class="VToolProMerge.Views.BatchMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VToolProMerge.Converters"
             xmlns:m="clr-namespace:VToolProMerge.Models"
             Background="{StaticResource BgAppBrush}">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusSoft" Soft="True"/>
        <conv:StatusToBrushConverter x:Key="StatusFg" Soft="False"/>
        <conv:TemplateKindToBrushConverter x:Key="KindBg"/>
        <conv:TemplateKindToLetterConverter x:Key="KindLetter"/>
        <conv:IssueSeverityToBrushConverter x:Key="IssueSoft" Soft="True"/>
        <conv:IssueSeverityToBrushConverter x:Key="IssueFg" Soft="False"/>
        <conv:StepStatusToBrushConverter x:Key="StepBg"/>
        <conv:StepStatusToForegroundConverter x:Key="StepFg"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Stats -->
            <RowDefinition Height="*"/>    <!-- 4 columns -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
        </Grid.RowDefinitions>

        <!-- ====== STATS ====== -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="5" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIconBox}" Background="{StaticResource BrandPrimarySoftBrush}">
                        <TextBlock Text="📄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedCount}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text=" mẫu được chọn" FontSize="13" Margin="6,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Tổng số mẫu trong gói" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIconBox}" Background="{StaticResource SuccessSoftBrush}">
                        <TextBlock Text="{}{ }" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PlaceholderCount}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text=" placeholder" FontSize="13" Margin="6,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Tổng số placeholder" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIconBox}" Background="#EDE9FE">
                        <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DynamicTableCount}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text=" bảng động" FontSize="13" Margin="6,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Trong các mẫu đã chọn" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIconBox}" Background="{StaticResource WarningSoftBrush}">
                        <TextBlock Text="🔻" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConditionCount}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text=" điều kiện" FontSize="13" Margin="6,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Trong các mẫu đã chọn" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource StatIconBox}" Background="{StaticResource DangerSoftBrush}">
                        <TextBlock Text="⚠" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WarningCount}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text=" cảnh báo" FontSize="13" Margin="6,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Cần xem xét" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ====== 4 COLUMNS ====== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="280"/>
                <ColumnDefinition Width="1.0*" MinWidth="280"/>
                <ColumnDefinition Width="1.0*" MinWidth="280"/>
                <ColumnDefinition Width="1.2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Col 1: Chọn mẫu -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="1. Chọn mẫu cần sinh" Style="{StaticResource H3}"/>
                        <TextBlock Text="{Binding SelectedTotalText}" HorizontalAlignment="Right"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:BatchTemplateItem}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="4"
                                                    Background="{Binding Kind, Converter={StaticResource KindBg}}"
                                                    Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Kind, Converter={StaticResource KindLetter}}"
                                                           Foreground="White" FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="3" Style="{StaticResource Tag}" Margin="6,0,8,0"
                                                    Background="{StaticResource BgChipBrush}">
                                                <TextBlock Text="{Binding Category}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Grid.Column="4" Padding="8,3" CornerRadius="6"
                                                    Background="{Binding Status, Converter={StaticResource StatusSoft}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6"
                                                             Fill="{Binding Status, Converter={StaticResource StatusFg}}"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedTotalText, StringFormat=Đã chọn {0} mẫu}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <Button Content="Bỏ chọn tất cả" HorizontalAlignment="Right"
                                Style="{StaticResource BtnGhost}"
                                Command="{Binding DeselectAllCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Col 2: Dữ liệu & kiểm tra -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="2. Dữ liệu &amp; kiểm tra" Style="{StaticResource H3}"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnGhost}"
                                Command="{Binding RecheckCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,6,0"/>
                                <TextBlock Text="Kiểm tra lại"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:MergeIssue}">
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="8"
                                                    Background="{Binding Severity, Converter={StaticResource IssueSoft}}">
                                                <TextBlock Text="📄" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Severity, Converter={StaticResource IssueFg}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Foreground="{Binding Severity, Converter={StaticResource IssueFg}}"
                                                               FontWeight="SemiBold" FontSize="12">
                                                        <Run Text="{Binding Count}"/>
                                                        <Run Text=" mục"/>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource Caption}" Margin="0,4,0,8"
                                                           TextWrapping="Wrap"/>
                                                <Button Content="{Binding ActionLabel}"
                                                        Style="{StaticResource BtnGhost}"
                                                        HorizontalAlignment="Left"
                                                        Padding="10,4" MinHeight="28" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{StaticResource SuccessSoftBrush}"
                            CornerRadius="8" Padding="10" Margin="0,8,0,0">
                        <TextBlock Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold">
                            <Run Text="Tổng kết: "/>
                            <Run Text="{Binding ErrorCount, Mode=OneWay}"/>
                            <Run Text=" lỗi, "/>
                            <Run Text="{Binding WarningCount, Mode=OneWay}"/>
                            <Run Text=" cảnh báo"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Col 3: Kết quả đầu ra -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="3. Kết quả đầu ra" Style="{StaticResource H3}" Margin="0,0,0,12"/>

                        <TextBlock Text="Thư mục lưu kết quả" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDir}"/>
                            <Button Grid.Column="1" Content="⋯" Style="{StaticResource BtnGhost}"
                                    Margin="6,0,0,0" Width="40"
                                    Command="{Binding BrowseFolderCommand}"/>
                        </Grid>

                        <TextBlock Text="Quy tắc đặt tên file (đặt tên động)"
                                   Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FileNamePattern}"/>
                            <Button Grid.Column="1" Content="{}{ }" Style="{StaticResource BtnGhost}"
                                    Margin="6,0,0,0" Width="40"/>
                        </Grid>

                        <TextBlock Text="Định dạng xuất file"
                                   Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Content="DOCX" IsChecked="{Binding ExportDocx}" Margin="0,0,18,0"/>
                            <RadioButton Content="PDF" IsChecked="{Binding ExportPdf}" Margin="0,0,18,0"/>
                            <RadioButton Content="DOCX + PDF" IsChecked="{Binding ExportBoth}"/>
                        </StackPanel>

                        <CheckBox Content="Mở file sau khi xuất" IsChecked="{Binding OpenFileAfter}"/>
                        <CheckBox Content="Mở thư mục sau khi xuất" IsChecked="{Binding OpenFolderAfter}"/>
                        <CheckBox Content="Lưu lịch sử sinh hồ sơ" IsChecked="{Binding SaveHistory}"/>
                        <CheckBox Content="Ghi log chi tiết" IsChecked="{Binding WriteDetailedLog}"/>
                        <CheckBox Content="In ngay sau khi tạo (nếu có)" IsChecked="{Binding PrintAfter}"/>

                        <ComboBox Margin="0,10,0,0">
                            <ComboBoxItem Content="Chọn máy in..." IsSelected="True"/>
                        </ComboBox>

                        <Button Content="⚙ Thiết lập nâng cao" Margin="0,14,0,0"
                                Style="{StaticResource BtnGhost}"
                                Command="{Binding AdvancedSettingsCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Col 4: Xem trước & lịch sử -->
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="4. Xem trước &amp; lịch sử" Style="{StaticResource H3}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
                        <Border Background="{StaticResource BrandPrimarySoftBrush}"
                                CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="Xem trước kết quả" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandPrimaryBrush}"/>
                        </Border>
                        <Border Background="{StaticResource BgChipBrush}"
                                CornerRadius="6" Padding="10,4">
                            <TextBlock Text="Lịch sử sinh hồ sơ"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding OutputFiles}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Tệp tin" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="4"
                                                    Background="{StaticResource WordBlueBrush}" Margin="0,0,8,0">
                                                <TextBlock Text="W" Foreground="White" FontWeight="Bold" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Format}" Width="60"/>
                            <DataGridTextColumn Header="Kích thước" Binding="{Binding SizeText}" Width="80"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="6"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Status, Converter={StaticResource StatusSoft}}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,12,0,6">
                        <TextBlock Text="Nhật ký gần đây" Style="{StaticResource H3}" FontSize="13"/>
                        <TextBlock HorizontalAlignment="Right" Text="Xem tất cả"
                                   Foreground="{StaticResource BrandPrimaryBrush}" Cursor="Hand"
                                   FontSize="12"/>
                    </Grid>
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:AuditLogItem}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Width="120"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12"
                                               Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== PROGRESS BAR ====== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tiến trình xử lý" Style="{StaticResource H3}" FontSize="13"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,20,0" VerticalAlignment="Center">
                    <!-- Step 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{Binding Step1Done, Converter={StaticResource StepBg}}">
                            <TextBlock Text="1" FontWeight="Bold"
                                       Foreground="{Binding Step1Done, Converter={StaticResource StepFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Kiểm tra dữ liệu" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Chưa bắt đầu" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Step 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{Binding Step2Done, Converter={StaticResource StepBg}}">
                            <TextBlock Text="2" FontWeight="Bold"
                                       Foreground="{Binding Step2Done, Converter={StaticResource StepFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Tạo file" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Chưa bắt đầu" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Step 3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{Binding Step3Done, Converter={StaticResource StepBg}}">
                            <TextBlock Text="3" FontWeight="Bold"
                                       Foreground="{Binding Step3Done, Converter={StaticResource StepFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Xuất file" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Chưa bắt đầu" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Step 4 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{Binding Step4Done, Converter={StaticResource StepBg}}">
                            <TextBlock Text="4" FontWeight="Bold"
                                       Foreground="{Binding Step4Done, Converter={StaticResource StepFg}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Hoàn tất" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Chưa bắt đầu" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <ProgressBar Width="180" Height="8" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Background="{StaticResource BgChipBrush}"
                                     Foreground="{StaticResource BrandPrimaryBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                   Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnGhost}"
                            Padding="14,10" MinHeight="44" Margin="0,0,10,0"
                            Command="{Binding DemoCommand}"
                            ToolTip="Engine sẽ tự tạo file mẫu Hợp đồng (.docx) trong %TEMP% rồi chạy end-to-end: bảng động + điều kiện + placeholder.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" Margin="0,0,8,0"/>
                            <TextBlock Text="Demo: Tạo mẫu + sinh thử" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPrimary}"
                            Padding="22,10" MinHeight="44"
                            Command="{Binding GenerateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,8,0" Foreground="White"/>
                            <TextBlock Text="Sinh bộ hồ sơ" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
