<UserControl x:Class="VToolProMerge.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgAppBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Lịch sử sinh hồ sơ" Style="{StaticResource H1}" Margin="0,0,0,16"/>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Logs}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding Time, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="160"/>
                    <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="160"/>
                    <DataGridTextColumn Header="Hồ sơ" Binding="{Binding Profile}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
