<UserControl x:Class="VToolProMerge.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgAppBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource BodySecondary}" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ Thêm hồ sơ" Style="{StaticResource BtnPrimary}"
                        Command="{Binding AddCommand}"/>
                <Button Content="Đổi tên" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        Command="{Binding RenameCommand}"/>
                <Button Content="Xoá" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: list of profiles -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BgSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="Danh sách hồ sơ làm việc" FontWeight="SemiBold"/>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column" RowHeight="40"
                              BorderThickness="0" Background="Transparent"
                              AlternatingRowBackground="{StaticResource BgSubtleBrush}"
                              SelectionMode="Single" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên hồ sơ" Width="*"
                                                Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Nguồn dữ liệu" Width="160"
                                                Binding="{Binding DataSource}"/>
                            <DataGridTextColumn Header="Mẫu" Width="60"
                                                Binding="{Binding TemplateCount}"/>
                            <DataGridTextColumn Header="Lịch sử" Width="70"
                                                Binding="{Binding HistoryCount}"/>
                            <DataGridTextColumn Header="File đã sinh" Width="100"
                                                Binding="{Binding OutputCount}"/>
                            <DataGridTextColumn Header="Sửa lần cuối" Width="140"
                                                Binding="{Binding ModifiedAtText}"/>
                            <DataGridTextColumn Header="Trạng thái" Width="100"
                                                Binding="{Binding StatusText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: detail panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="Chi tiết hồ sơ" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="20,16">
                        <TextBlock Text="{Binding Selected.Name}"
                                   FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.Description}"
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,4,0,16" TextWrapping="Wrap"/>

                        <Border Background="{StaticResource BrandPrimarySoftBrush}"
                                CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Selected.StatusText}"
                                       Foreground="{StaticResource BrandPrimaryDarkBrush}"
                                       FontWeight="SemiBold" FontSize="12"/>
                        </Border>

                        <TextBlock Text="Nguồn dữ liệu" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding Selected.DataSource}" FontFamily="Consolas"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Selected.TemplateCount}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Mẫu" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Selected.HistoryCount}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Lượt sinh" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Selected.OutputCount}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="File đã sinh" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Sửa lần cuối" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                        <TextBlock Text="{Binding Selected.ModifiedAtText}"/>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="16,12">
                        <StackPanel>
                            <Button Content="Đặt làm hồ sơ đang dùng"
                                    Style="{StaticResource BtnPrimary}"
                                    Command="{Binding ActivateCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Mở mẫu"
                                        Style="{StaticResource BtnGhost}"
                                        Command="{Binding OpenTemplatesCommand}"/>
                                <Button Grid.Column="2" Content="Mở lịch sử"
                                        Style="{StaticResource BtnGhost}"
                                        Command="{Binding OpenHistoryCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
