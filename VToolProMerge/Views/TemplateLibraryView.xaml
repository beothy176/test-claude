<UserControl x:Class="VToolProMerge.Views.TemplateLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VToolProMerge.Converters"
             xmlns:m="clr-namespace:VToolProMerge.Models"
             Background="{StaticResource BgAppBrush}">

    <UserControl.Resources>
        <conv:CategoryToTagBrushConverter x:Key="CatBg"/>
        <conv:CategoryToTagBrushConverter x:Key="CatFg" ReturnTextBrush="True"/>
        <conv:TemplateKindToBrushConverter x:Key="KindBg"/>
        <conv:TemplateKindToLetterConverter x:Key="KindLetter"/>
        <conv:IsNullConverter x:Key="IsNotNull"/>
        <conv:StatusToBrushConverter x:Key="StatusSoft" Soft="True"/>
        <conv:StatusToBrushConverter x:Key="StatusFg" Soft="False"/>
        <conv:EqualMultiToBrushConverter x:Key="SelectedBorder"/>
        <conv:EqualMultiToVisibilityConverter x:Key="SelectedCheckVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: list -->
        <Grid Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title row + view toggle -->
            <Grid>
                <TextBlock Text="Thư viện mẫu" Style="{StaticResource H1}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{StaticResource BgChipBrush}" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="▦" Width="36" Height="32"
                                    Command="{Binding ToggleViewCommand}" CommandParameter="grid"
                                    Background="{StaticResource BrandPrimaryBrush}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="☰" Width="36" Height="32" Margin="2,0,0,0"
                                    Command="{Binding ToggleViewCommand}" CommandParameter="list"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Filter chips -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,18,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Display}"
                                Style="{StaticResource BtnChip}"
                                Margin="0,0,8,8"
                                Command="{Binding DataContext.FilterCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Name}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cards grid -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:TemplateItem}">
                            <Border Width="320" Margin="0,0,16,16"
                                    Background="White"
                                    BorderThickness="2"
                                    CornerRadius="12" Padding="16"
                                    Cursor="Hand">
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource SelectedBorder}">
                                        <Binding Path="Id"/>
                                        <Binding Path="DataContext.Selected.Id"
                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <Grid>
                                        <Border Width="44" Height="44"
                                                Background="{Binding Kind, Converter={StaticResource KindBg}}"
                                                CornerRadius="8" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource KindLetter}}"
                                                       Foreground="White" FontWeight="Bold" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="11"
                                                    Background="{StaticResource BrandPrimaryBrush}"
                                                    VerticalAlignment="Center">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource SelectedCheckVis}">
                                                        <Binding Path="Id"/>
                                                        <Binding Path="DataContext.Selected.Id"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Content="⋯" Width="28" Height="28"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource TextMutedBrush}" FontSize="18"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                               Margin="0,12,0,6"/>
                                    <Border Style="{StaticResource Tag}"
                                            Background="{Binding Category, Converter={StaticResource CatBg}}">
                                        <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Category, Converter={StaticResource CatFg}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodySecondary}"
                                               Margin="0,10,0,12"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}"/>
                                        <TextBlock Grid.Column="1" Margin="14,0,0,0"
                                                   Style="{StaticResource Caption}">
                                            <Run Text="📅 "/>
                                            <Run Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy}}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Margin="14,0,0,0"
                                                   Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="👤 "/>
                                            <Run Text="{Binding Author}"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- RIGHT: info panel -->
        <Grid Grid.Column="1" Margin="0,20,24,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Thông tin mẫu -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="Thông tin mẫu" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48"
                                        Background="{Binding Kind, Converter={StaticResource KindBg}}"
                                        CornerRadius="8" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource KindLetter}}"
                                               Foreground="White" FontWeight="Bold" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"/>
                                    <Border Style="{StaticResource Tag}" Margin="0,6,0,0"
                                            Background="{Binding Category, Converter={StaticResource CatBg}}">
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Category, Converter={StaticResource CatFg}}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding Description}"
                                       Style="{StaticResource BodySecondary}"
                                       Margin="0,0,0,14"/>

                            <ItemsControl>
                                <ItemsControl.Resources>
                                    <Style x:Key="Row" TargetType="Grid">
                                        <Setter Property="Margin" Value="0,4"/>
                                    </Style>
                                </ItemsControl.Resources>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🕒  Phiên bản" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📅  Ngày cập nhật" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="👤  Tác giả" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Author}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📐  Kích thước" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📄  Định dạng" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Format}" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🕒  Lần sử dụng cuối" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastUsedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="👁  Số lần sử dụng" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UseCount}" FontWeight="SemiBold"/>
                                </Grid>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tóm tắt placeholder -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="Tóm tắt placeholder" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📋  Tổng số placeholder" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PlaceholderCount}" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📊  Bảng động" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DynamicTableCount}" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="❓  Điều kiện" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConditionCount}" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🕘  Trạng thái" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Grid.Column="1" Padding="8,3" CornerRadius="6"
                                        Background="{Binding Status, Converter={StaticResource StatusSoft}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{Binding Status, Converter={StaticResource StatusFg}}"
                                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
