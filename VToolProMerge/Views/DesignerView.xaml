<UserControl x:Class="VToolProMerge.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VToolProMerge.Converters"
             xmlns:m="clr-namespace:VToolProMerge.Models"
             Background="{StaticResource BgAppBrush}">

    <UserControl.Resources>
        <conv:StringEqualsToVisibilityConverter x:Key="TabVis"/>
        <conv:StringEqualsConverter x:Key="TabActive"/>

        <Style x:Key="ToolbarBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="FormatBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Breadcrumb + Mode -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Format bar -->
            <RowDefinition Height="*"/>    <!-- Body -->
        </Grid.RowDefinitions>

        <!-- BREADCRUMB + MODE -->
        <Grid Background="White" Margin="0">
            <Grid Margin="20,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Thiết kế mẫu" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  ›  " Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TemplateName}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{StaticResource BgChipBrush}" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="DesignMode" Content="Design Mode"
                                         IsChecked="{Binding IsDesignMode}" Padding="14,6"
                                         FontWeight="SemiBold">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource BrandPrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton GroupName="DesignMode" Content="End User Mode"
                                         IsChecked="{Binding IsEndUserMode}" Padding="14,6">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource BrandPrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid Margin="20,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarBtn}" Background="{StaticResource BrandPrimaryBrush}"
                            Foreground="White" BorderBrush="{StaticResource BrandPrimaryBrush}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="Lưu" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding SaveAsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                            <TextBlock Text="Lưu với tên..."/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Background="{StaticResource BorderBrush}"
                            Margin="6,0,12,0"/>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding InsertFieldCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0"/>
                            <TextBlock Text="Chèn field"/>
                            <TextBlock Text="  ▾" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding ScanPlaceholderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,6,0"/>
                            <TextBlock Text="Quét placeholder"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding InsertTableCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,6,0"/>
                            <TextBlock Text="Bảng động"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding InsertConditionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❓" Margin="0,0,6,0"/>
                            <TextBlock Text="Điều kiện"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding InsertImageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼" Margin="0,0,6,0"/>
                            <TextBlock Text="Chèn ảnh"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding InsertSubdocCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📎" Margin="0,0,6,0"/>
                            <TextBlock Text="Chèn phụ lục"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding PreviewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁" Margin="0,0,6,0"/>
                            <TextBlock Text="Xem thử"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding CheckErrorsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" Margin="0,0,6,0"/>
                            <TextBlock Text="Kiểm tra lỗi"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Dữ liệu xem thử:" VerticalAlignment="Center"
                               Margin="14,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding PreviewDatasets}"
                              SelectedItem="{Binding PreviewDataset}"
                              Width="180"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORMAT BAR -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,6">
                <ComboBox Width="160" Text="{Binding FontName}" IsEditable="True"/>
                <ComboBox Width="60" Margin="6,0,0,0" Text="{Binding FontSize}" IsEditable="True"/>
                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0"/>
                <Button Style="{StaticResource FormatBtn}" Content="B" FontWeight="Bold"/>
                <Button Style="{StaticResource FormatBtn}" Content="I" FontStyle="Italic"/>
                <Button Style="{StaticResource FormatBtn}">
                    <TextBlock Text="U" TextDecorations="Underline"/>
                </Button>
                <Button Style="{StaticResource FormatBtn}" Content="A" Foreground="{StaticResource BrandPrimaryBrush}" FontWeight="Bold"/>
                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0"/>
                <Button Style="{StaticResource FormatBtn}" Content="≡"/>
                <Button Style="{StaticResource FormatBtn}" Content="≡"/>
                <Button Style="{StaticResource FormatBtn}" Content="≡"/>
                <Button Style="{StaticResource FormatBtn}" Content="≡"/>
                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0"/>
                <Button Style="{StaticResource FormatBtn}" Content="• ="/>
                <Button Style="{StaticResource FormatBtn}" Content="1."/>
                <Button Style="{StaticResource FormatBtn}" Content="↤"/>
                <Button Style="{StaticResource FormatBtn}" Content="↦"/>
                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0"/>
                <Button Style="{StaticResource FormatBtn}" Content="∑"/>
            </StackPanel>
        </Border>

        <!-- BODY: Word area + Tab strip + Right panels -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- Word area -->
                <ColumnDefinition Width="64"/>    <!-- Right tab strip -->
                <ColumnDefinition Width="640" MinWidth="500"/> <!-- Right panels -->
            </Grid.ColumnDefinitions>

            <!-- WORD A4 PREVIEW AREA -->
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top ruler (decorative) -->
                <Border Grid.Row="0" Height="20" Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Margin="56,0,0,0">
                    <Canvas>
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Canvas>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="{StaticResource BgAppBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Vertical ruler -->
                        <Border Grid.Column="0" Background="White" Width="40"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                            <ItemsControl>
                                <ItemsControl.ItemsSource>
                                    <x:Array Type="{x:Type sys:Int32}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                        <sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32><sys:Int32>3</sys:Int32>
                                        <sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32><sys:Int32>6</sys:Int32>
                                        <sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32><sys:Int32>9</sys:Int32>
                                        <sys:Int32>10</sys:Int32><sys:Int32>11</sys:Int32><sys:Int32>12</sys:Int32>
                                        <sys:Int32>13</sys:Int32><sys:Int32>14</sys:Int32><sys:Int32>15</sys:Int32>
                                        <sys:Int32>16</sys:Int32>
                                    </x:Array>
                                </ItemsControl.ItemsSource>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Height="50" VerticalAlignment="Top"
                                                   Margin="0,16,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- A4 page mockup -->
                        <Border Grid.Column="1" Background="White" Margin="40,16,40,16"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                Padding="60,50" MinWidth="700" MaxWidth="900"
                                HorizontalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" Opacity="0.08" BlurRadius="14" ShadowDepth="3"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header rows -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="[DONVI_TEN]" FontWeight="Bold" FontFamily="Times New Roman"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Center" FontFamily="Times New Roman">
                                            <Run Text="Số: "/><Run Text="[SO_HOP_DONG]"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM"
                                                   FontWeight="Bold" FontFamily="Times New Roman"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Độc lập - Tự do - Hạnh phúc"
                                                   FontWeight="Bold" FontFamily="Times New Roman"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontStyle="Italic" FontFamily="Times New Roman">
                                            <Run Text="Ngày "/><Run Text="[NGAY_KY]"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="HỢP ĐỒNG MUA BÁN HÀNG HÓA"
                                           FontWeight="Bold" FontSize="16" FontFamily="Times New Roman"
                                           HorizontalAlignment="Center" Margin="0,30,0,4"/>
                                <TextBlock Text="-----o0o-----" HorizontalAlignment="Center"
                                           FontFamily="Times New Roman" Margin="0,0,0,16"/>

                                <TextBlock FontStyle="Italic" FontFamily="Times New Roman"
                                           Text="Căn cứ Bộ luật Dân sự số 91/2015/QH13 ngày 24/11/2015;"/>
                                <TextBlock FontStyle="Italic" FontFamily="Times New Roman"
                                           Text="Căn cứ nhu cầu và khả năng của hai bên."/>

                                <TextBlock FontFamily="Times New Roman" Margin="0,10,0,0">
                                    <Run Text="Hôm nay, ngày "/><Run Text="[NGAY_KY]"/><Run Text=", tại "/><Run Text="[DONVI_TEN]"/><Run Text=", chúng tôi gồm có:"/>
                                </TextBlock>

                                <TextBlock Text="BÊN A (BÊN MUA):" FontWeight="Bold" FontFamily="Times New Roman"
                                           Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock FontFamily="Times New Roman" Text="Tên đơn vị"/>
                                    <TextBlock Grid.Column="1" FontFamily="Times New Roman" Text=": [DONVI_TEN]"/>
                                    <TextBlock Grid.Row="1" FontFamily="Times New Roman" Text="Mã số thuế"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Times New Roman" Text=": [DONVI_MST]"/>
                                    <TextBlock Grid.Row="2" FontFamily="Times New Roman" Text="Địa chỉ"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Times New Roman" Text=": [DONVI_DIA_CHI]"/>
                                    <TextBlock Grid.Row="3" FontFamily="Times New Roman" Text="Người đại diện"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Times New Roman" Text=": [DONVI_NGUOI_DD]"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" FontFamily="Times New Roman" Text="Chức vụ:"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" FontFamily="Times New Roman" Text="[DONVI_CHUC_VU]"/>
                                </Grid>

                                <TextBlock Text="BÊN B (BÊN BÁN):" FontWeight="Bold" FontFamily="Times New Roman"
                                           Margin="0,16,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock FontFamily="Times New Roman" Text="Tên đơn vị"/>
                                    <TextBlock Grid.Column="1" FontFamily="Times New Roman" Text=": [NT_TEN]"/>
                                    <TextBlock Grid.Row="1" FontFamily="Times New Roman" Text="Mã số thuế"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Times New Roman" Text=": [NT_MST]"/>
                                    <TextBlock Grid.Row="2" FontFamily="Times New Roman" Text="Địa chỉ"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Times New Roman" Text=": [NT_DIA_CHI]"/>
                                </Grid>

                                <TextBlock Text="Điều 1. Hàng hóa và giá trị hợp đồng"
                                           FontWeight="Bold" FontFamily="Times New Roman" Margin="0,18,0,6"/>
                                <TextBlock FontStyle="Italic" FontFamily="Times New Roman"
                                           Text="Bên B đồng ý bán, Bên A đồng ý mua các mặt hàng với tên hàng, số lượng, đơn giá và thành tiền như sau:"/>

                                <!-- Dynamic table mock -->
                                <Border BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="1"
                                        Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="STT" FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Column="1" Text="Mã hàng" FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Column="2" Text="Tên hàng hóa" FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Column="3" Text="ĐVT" FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Column="4" Text="Số lượng" FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Column="5" Text="Đơn giá" FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Column="6" Text="Thành tiền" FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>

                                        <TextBlock Grid.Row="1" Text="[HH_STT]" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="[HH_MA]" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="[HH_TEN]" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="[HH_DVT]" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="[HH_SL]" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Row="1" Grid.Column="5" Text="[HH_DG]" Padding="6" FontFamily="Times New Roman"/>
                                        <TextBlock Grid.Row="1" Grid.Column="6" Text="[HH_TT]" Padding="6" FontFamily="Times New Roman"/>

                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Text="Tổng cộng:"
                                                   FontWeight="Bold" Padding="6" FontFamily="Times New Roman"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="6" Text="[TONG_TIEN]"
                                                   FontWeight="Bold" Padding="6" FontFamily="Times New Roman"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Bottom info bar (page / words / language / zoom) -->
                <Border Grid.Row="2" Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="20,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="Trang "/><Run Text="{Binding PageNumber}"/>
                                <Run Text=" / "/><Run Text="{Binding PageCount}"/>
                            </TextBlock>
                            <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="14,0"/>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{Binding WordCount}"/><Run Text=" từ"/>
                            </TextBlock>
                            <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="14,0"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Tiếng Việt"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FormatBtn}" Content="—"/>
                            <Slider Width="120" Minimum="50" Maximum="200" Value="{Binding Zoom}"
                                    VerticalAlignment="Center" Margin="6,0"/>
                            <Button Style="{StaticResource FormatBtn}" Content="+"/>
                            <TextBlock Text="{Binding Zoom, StringFormat={}{0:0}%}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT TAB STRIP (vertical) -->
            <Border Grid.Column="1" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0">
                <StackPanel Margin="0,12">
                    <Button Style="{StaticResource BtnIcon}" MinHeight="84"
                            Command="{Binding SwitchTabCommand}" CommandParameter="DataSource">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{StaticResource BrandPrimarySoftBrush}">
                                <TextBlock Text="🗄" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nguồn" FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="dữ liệu" FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" MinHeight="74"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Element">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource BgChipBrush}">
                                <TextBlock Text="🌳" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cây" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="phần tử" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" MinHeight="74"
                            Command="{Binding SwitchTabCommand}" CommandParameter="QuickBuilder">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource BgChipBrush}">
                                <TextBlock Text="⚡" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Quick" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Builder" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" MinHeight="74"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Properties">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource BgChipBrush}">
                                <TextBlock Text="⚙" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Thuộc" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="tính" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- RIGHT 4 PANELS (always visible — like the screenshot) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="14,12,14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Nguồn dữ liệu -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,8">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="1. Nguồn dữ liệu" Style="{StaticResource H3}" FontSize="14"/>
                                <TextBlock Text="›" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DataSourceTree}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:DataSourceNode}">
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="▸" FontSize="11" Width="14"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Icon}" Width="22"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 2. Cây phần tử -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2. Cây phần tử" Style="{StaticResource H3}" FontSize="14"/>
                            <ItemsControl ItemsSource="{Binding Elements}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:ElementNode}">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22" CornerRadius="4"
                                                        Background="{StaticResource BgChipBrush}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Icon}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Quick Builder -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="3. Quick Builder" Style="{StaticResource H3}" FontSize="14"/>
                            <ItemsControl ItemsSource="{Binding QuickBuilders}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,6" Padding="10,8" MinHeight="36"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Left"
                                                Background="{StaticResource BrandPrimarySoftBrush}"
                                                BorderThickness="0"
                                                Foreground="{StaticResource BrandPrimaryBrush}"
                                                Command="{Binding DataContext.QuickBuilderCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Title}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 4. Chi tiết / Thuộc tính -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="4. Chi tiết (Thuộc tính)" Style="{StaticResource H3}" FontSize="14"/>
                            <TextBlock Text="Bảng hàng hóa (Table)" FontWeight="SemiBold" Margin="0,10,0,8"/>

                            <ItemsControl>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kiểu phần tử" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedElementType}" IsReadOnly="True"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tên" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedElementName}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Nguồn dữ liệu" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox Grid.Column="1" Text="{Binding SelectedElementSource}"
                                              IsEditable="True"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Số dòng (xem thử)" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding PreviewRows}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lặp khi không có dữ liệu" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding RepeatWhenEmpty}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lặp tiêu đề" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding RepeatHeader}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Số dòng lặp tiêu đề" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding HeaderRepeatCount}"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Đường kẻ" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox Grid.Column="1" Text="{Binding BorderStyle}" IsEditable="True">
                                        <ComboBoxItem>Tất cả</ComboBoxItem>
                                        <ComboBoxItem>Chỉ ngoài</ComboBoxItem>
                                        <ComboBoxItem>Không có</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Canh lề trong ô" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox Grid.Column="1" Text="{Binding CellAlign}" IsEditable="True">
                                        <ComboBoxItem>Trên</ComboBoxItem>
                                        <ComboBoxItem>Giữa</ComboBoxItem>
                                        <ComboBoxItem>Dưới</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Khoảng cách dòng" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding LineSpacing}"/>
                                </Grid>
                                <Button Style="{StaticResource BtnGhost}" Content="Nâng cao  ›"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
