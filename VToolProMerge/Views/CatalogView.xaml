<UserControl x:Class="VToolProMerge.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgAppBrush}">
    <Grid Margin="24,20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource BodySecondary}" Margin="0,8,0,0"/>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Bản skeleton — sẽ chứa cây nhóm danh mục và bảng chi tiết khi hoàn thiện."
                               Style="{StaticResource Body}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
