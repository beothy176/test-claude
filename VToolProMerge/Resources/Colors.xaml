<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand -->
    <Color x:Key="BrandPrimaryColor">#2563EB</Color>
    <Color x:Key="BrandPrimaryDarkColor">#1D4ED8</Color>
    <Color x:Key="BrandPrimaryLightColor">#DBEAFE</Color>
    <Color x:Key="BrandPrimarySoftColor">#EFF6FF</Color>

    <!-- Surfaces -->
    <Color x:Key="BgAppColor">#F5F7FB</Color>
    <Color x:Key="BgPanelColor">#FFFFFF</Color>
    <Color x:Key="BgSidebarColor">#FFFFFF</Color>
    <Color x:Key="BgTopbarColor">#FFFFFF</Color>
    <Color x:Key="BgChipColor">#F1F5F9</Color>
    <Color x:Key="BgSubtleColor">#F8FAFC</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessSoftColor">#DCFCE7</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSoftColor">#FEF3C7</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSoftColor">#FEE2E2</Color>
    <Color x:Key="InfoColor">#0EA5E9</Color>
    <Color x:Key="InfoSoftColor">#E0F2FE</Color>

    <!-- Tag colors per template type -->
    <Color x:Key="TagBaoGiaColor">#FEF3C7</Color>
    <Color x:Key="TagBaoGiaTextColor">#92400E</Color>
    <Color x:Key="TagHopDongColor">#DCFCE7</Color>
    <Color x:Key="TagHopDongTextColor">#166534</Color>
    <Color x:Key="TagDauThauColor">#DBEAFE</Color>
    <Color x:Key="TagDauThauTextColor">#1E40AF</Color>
    <Color x:Key="TagBaoCaoColor">#E0E7FF</Color>
    <Color x:Key="TagBaoCaoTextColor">#3730A3</Color>
    <Color x:Key="TagQuyetDinhColor">#FFE4E6</Color>
    <Color x:Key="TagQuyetDinhTextColor">#9F1239</Color>
    <Color x:Key="TagToTrinhColor">#FEF3C7</Color>
    <Color x:Key="TagToTrinhTextColor">#92400E</Color>
    <Color x:Key="TagDanhMucColor">#F1F5F9</Color>
    <Color x:Key="TagDanhMucTextColor">#334155</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource BrandPrimaryLightColor}"/>
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="{StaticResource BrandPrimarySoftColor}"/>

    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgAppColor}"/>
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgTopbarBrush" Color="{StaticResource BgTopbarColor}"/>
    <SolidColorBrush x:Key="BgChipBrush" Color="{StaticResource BgChipColor}"/>
    <SolidColorBrush x:Key="BgSubtleBrush" Color="{StaticResource BgSubtleColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>

    <SolidColorBrush x:Key="WordBlueBrush" Color="#2B579A"/>
    <SolidColorBrush x:Key="ExcelGreenBrush" Color="#107C41"/>

</ResourceDictionary>
