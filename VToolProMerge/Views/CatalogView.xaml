<UserControl x:Class="VToolProMerge.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgAppBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource H1}"/>
        <TextBlock Grid.Row="1" Text="{Binding Description}"
                   Style="{StaticResource BodySecondary}" Margin="0,8,0,16"
                   TextWrapping="Wrap"/>

        <!-- Body: 2 columns (groups | fields) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Groups -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="Nhóm danh mục" FontWeight="SemiBold"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="16"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FieldCount, StringFormat={}{0} trường}"
                                                   Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource BgChipBrush}"
                                            CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FieldCount}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Thêm nhóm" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding AddGroupCommand}"/>
                            <Button Content="Xoá" Style="{StaticResource BtnGhost}"
                                    Command="{Binding RemoveGroupCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Fields -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedGroup.Icon}" FontSize="16"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedGroup.Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="—" Margin="8,0" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="Chi tiết trường" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Thêm trường" Style="{StaticResource BtnPrimary}"
                                        Command="{Binding AddFieldCommand}"/>
                                <Button Content="Xoá trường" Style="{StaticResource BtnGhost}"
                                        Command="{Binding RemoveFieldCommand}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedGroup.Fields}"
                              SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column" RowHeight="36"
                              BorderThickness="0" Background="Transparent"
                              AlternatingRowBackground="{StaticResource BgSubtleBrush}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Placeholder" Width="180"
                                                Binding="{Binding Placeholder}"
                                                FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Nhãn hiển thị" Width="*"
                                                Binding="{Binding Label}"/>
                            <DataGridTextColumn Header="Kiểu" Width="100"
                                                Binding="{Binding Kind}"/>
                            <DataGridTextColumn Header="Mẫu" Width="180"
                                                Binding="{Binding Sample}"/>
                            <DataGridCheckBoxColumn Header="Bắt buộc" Width="80"
                                                    Binding="{Binding Required}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="{StaticResource BgSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="Mẹo: " FontWeight="SemiBold"/>
                            <Run Text="Khi tạo trường mới, placeholder sẽ tự sinh từ nhãn (ví dụ: 'Tên gói thầu' → [TEN_GOI_THAU])."/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
